{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.+\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": "<rootDir>/tsconfig.test.json"
    }]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testTimeout": 60000,
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.e2e-spec.ts",
    "!src/**/*.module.ts",
    "!src/main.ts",
    "!src/**/entities/**",
    "!src/**/dtos/**",
    "!src/**/migration/**",
    "!src/**/interfaces/**",
    "!src/**/consts/**"
  ],
  "coverageDirectory": "coverage-e2e",
  "coverageReporters": ["lcov", "text-summary"]
}